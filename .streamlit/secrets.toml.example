# Streamlit secrets, placeholders only. Copy to secrets.toml and fill in real values.
# Streamlit will prefer this file over .env when running the dashboard.

[snowflake]
account = "your_account_identifier"
user = "your_user"
password = "your_password"
warehouse = "COMPUTE_WH"
database = "OPSLENS"
schema = "PUBLIC"
role = "ACCOUNTADMIN"

[llm]
provider = "fallback"
openai_api_key = ""
anthropic_api_key = ""
huggingface_api_key = ""

[auth]
username = "ops"
password_hash = "$2b$12$placeholderplaceholderplaceholderplaceholderplaceholderpla"

[smtp]
host = "smtp.gmail.com"
port = 587
user = "your_smtp_user"
password = "your_smtp_password"
sender = "opslens@example.com"
recipients = "ops-team@example.com"
